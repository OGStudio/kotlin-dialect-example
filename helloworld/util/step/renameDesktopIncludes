#!/bin/bash

STEP=$((STEP+1))
echo -e "\n> > > > Step №$STEP. Rename Desktop includes: $DESKTOP"

FILES=$SDIR/../copy-desktop.txt
DST=$SDIR/../ver-$DESKTOP/src

# https://stackoverflow.com/a/1521470/3404710
cat $FILES | while read file || [[ -n $file ]]; do
    echo $file
    fileName=$DST/ignore.$file
    # 1. Replace
    replace $fileName "include \"" "include \"ignore."
    # 2. Revert corner cases
    replace $fileName "include \"ignore.ignore.kd" "include \"ignore.kd"
    replace $fileName "include \"ignore.lib" "include \"lib"
done

# Replace inside generated files
replace $DST/ignore.kd.h "include \"" "include \"ignore."
replace $DST/ignore.kd.cpp "include \"" "include \"ignore."
replace $DST/ignore.kd.cpp "include \"ignore.ignore.kd" "include \"ignore.kd"
